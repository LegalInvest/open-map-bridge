# Install as /etc/open-map-bridge/gateway.env with mode 0600.
OMB_GATEWAY_PORT=4174
OMB_WEB_ORIGIN=http://127.0.0.1:8080
OMB_GATEWAY_RATE_LIMIT=600
OMB_GATEWAY_TOKEN=REPLACE_WITH_A_RANDOM_32_TO_256_CHARACTER_SECRET
OMB_DATA_PATH=/var/lib/open-map-bridge/temporal-state.json
# Optional encrypted local credential vault. Configure both values together.
# Generate the 32-byte key locally, store it only in this 0600 environment file, and never commit or echo it.
# OMB_VAULT_PATH=/var/lib/open-map-bridge/credential-vault.json
# OMB_VAULT_KEY=REPLACE_WITH_AN_UNPADDED_BASE64URL_32_BYTE_KEY
# Optional OviBridge activation stays disabled until all three binding values are set.
# Date/probe JSON must contain only verified, non-secret metadata; never place credentials here.
# OMB_OVI_PORT=19991
# OMB_OVI_MAP_TYPE=200
# OMB_OVI_SOURCE_ID=00000000-0000-0000-0000-000000000000
# OMB_OVI_VERIFIED_DATES_JSON=[{"id":"verified-scene","requestDate":"2025-01-01","captureDate":null,"precision":"request-date-only","availability":"available"}]
# OMB_OVI_PROBE_JSON={"dateId":"verified-scene","z":8,"x":212,"y":102}
