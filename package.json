{
  "name": "open-map-bridge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <27",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "env:check": "node scripts/verify-environment.mjs",
    "fixtures:acquire": "node scripts/acquire-research-fixtures.mjs",
    "fixtures:verify": "node scripts/verify-local-fixtures.mjs",
    "test": "node --test scripts/*.test.mjs && vitest run --passWithNoTests",
    "test:compat": "vitest run --config vitest.compat.config.ts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "dev": "node scripts/dev.mjs",
    "test:e2e": "playwright test",
    "test:e2e:authorized-qr": "playwright test --config playwright.authorized.config.ts"
  },
  "dependencies": {
    "jpeg-js": "0.4.4",
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "jsdom": "30.0.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
